    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^8.56.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mocha": "^11.7.6",
    "typescript": "^5.3.3",
    "zod": "^3.23.0"
  },
