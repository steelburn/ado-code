{
  "name": "ado-code",
  "displayName": "ADO Code",
  "description": "AI coding assistant with Azure DevOps integration",
  "version": "0.5.7",
  "publisher": "steelburn",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:adoCode.chat",
    "onView:adoCode.workItems",
    "onCommand:adoCode.chat.focus",
    "onCommand:adoCode.refreshWorkItems",
    "onCommand:adoCode.startTask",
    "onCommand:adoCode.selectWorkItem",
    "onCommand:adoCode.delegateToAgent",
    "onCommand:adoCode.startTaskWithAgent",
    "onCommand:adoCode.reviewTaskDetail",
    "onCommand:adoCode.requestClarification",
    "onCommand:adoCode.checkTaskReplies",
    "onCommand:adoCode.changeWorkItemState",
    "onView:adoCode.unassignedWorkItems",
    "onCommand:adoCode.takeOwnership",
    "onCommand:adoCode.reassignWorkItem",
    "onCommand:adoCode.generateCommitMessage",
    "onView:adoCode.status",
    "onView:adoCode.worktrees",
    "onCommand:adoCode.refreshStatus",
    "onCommand:adoCode.showMemory",
    "onCommand:adoCode.editMemory",
    "onCommand:adoCode.clearMemory",
    "onCommand:adoCode.showWorkspaceMemory",
    "onCommand:adoCode.memoryExport",
    "onCommand:adoCode.memoryImport",
    "onCommand:adoCode.setMode",
    "onCommand:adoCode.listCheckpoints",
    "onCommand:adoCode.showTokenUsage",
    "onCommand:adoCode.mcpDisconnect",
    "onCommand:adoCode.mcpReconnect",
    "onCommand:adoCode.mcpViewDetails",
    "onCommand:adoCode.agentViewDetail",
    "onCommand:adoCode.memorySearch",
    "onCommand:adoCode.workItemsFilter",
    "onCommand:adoCode.workItemsSearch",
    "onCommand:adoCode.workItemsClearFilters",
    "onCommand:adoCode.worktreeShowChanges",
    "onCommand:adoCode.generateTasks"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "adoCode.selectWorkItem",
        "title": "Select Work Item"
      },
      {
        "command": "adoCode.startTask",
        "title": "Start Task",
        "icon": "$(rocket)"
      },
      {
        "command": "adoCode.switchOrganization",
        "title": "Switch Organization…",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.refreshWorkItems",
        "title": "Refresh Work Items",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.chat.focus",
        "title": "Focus Chat"
      },
      {
        "command": "adoCode.delegateToAgent",
        "title": "Delegate to Agent…"
      },
      {
        "command": "adoCode.startTaskWithAgent",
        "title": "Assign to Agent…"
      },
      {
        "command": "adoCode.reviewTaskDetail",
        "title": "Review Task Detail"
      },
      {
        "command": "adoCode.showWorkItemDetail",
        "title": "Show Full Details",
        "icon": "$(open-preview)"
      },
      {
        "command": "adoCode.requestClarification",
        "title": "Request Clarification…"
      },
      {
        "command": "adoCode.checkTaskReplies",
        "title": "Check Replies"
      },
      {
        "command": "adoCode.changeWorkItemState",
        "title": "Change Item Status",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.takeOwnership",
        "title": "Take Ownership",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.reassignWorkItem",
        "title": "Reassign To…",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.unselectWorkItem",
        "title": "Deselect Work Item",
        "icon": "$(close-all)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.deleteMemory",
        "title": "Delete Memory",
        "icon": "$(trash)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.moveToWorkspaceMemory",
        "title": "Move to Workspace Memory",
        "icon": "$(folder-opened)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.moveToUserMemory",
        "title": "Move to User Memory",
        "icon": "$(person)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.openAgentInTerminal",
        "title": "Open in Terminal",
        "icon": "$(terminal)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.copyAgentName",
        "title": "Copy Agent Name",
        "icon": "$(clippy)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.openWorktreeInTerminal",
        "title": "Open Worktree in Terminal",
        "icon": "$(terminal)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.openWorktreeInExplorer",
        "title": "Open Worktree in Explorer",
        "icon": "$(folder-opened)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.removeWorktree",
        "title": "Remove Worktree",
        "icon": "$(trash)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.commitWorktree",
        "title": "Commit & Push Worktree",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.cleanupWorktree",
        "title": "Clean Up After Merge",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.worktreeShowChanges",
        "title": "Show Changes",
        "icon": "$(diff)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.generateCommitMessage",
        "title": "Generate Commit Message",
        "icon": "$(sparkle)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.refreshStatus",
        "title": "Refresh Status",
        "icon": "$(refresh)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.refreshWorktrees",
        "title": "Refresh Worktrees",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.worktreesRemoveAllCompleted",
        "title": "Remove All Completed Worktrees",
        "icon": "$(trash)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.showAgentOutput",
        "title": "Show Agent Output",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.showMemory",
        "title": "Show Memory",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.editMemory",
        "title": "Edit Memory Entry…",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.clearMemory",
        "title": "Clear All Memory",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.showWorkspaceMemory",
        "title": "Show Workspace Memory",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.memoryExport",
        "title": "Export Memories",
        "icon": "$(export)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.memoryImport",
        "title": "Import Memories",
        "icon": "$(import)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.memorySearch",
        "title": "Search Memories",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.setMode",
        "title": "Set Mode…",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.listCheckpoints",
        "title": "List Checkpoints…",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.showTokenUsage",
        "title": "Show Token Usage",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.cycleMode",
        "title": "Cycle Mode",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.mcpDisconnect",
        "title": "Disconnect",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.mcpReconnect",
        "title": "Reconnect",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.mcpViewDetails",
        "title": "View Details",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.runViewSummary",
        "title": "View Summary"
      },
      {
        "command": "adoCode.runOpenWorktree",
        "title": "Open Worktree"
      },
      {
        "command": "adoCode.runCopyId",
        "title": "Copy Run ID"
      },
      {
        "command": "adoCode.agentViewDetail",
        "title": "View Details"
      },
      {
        "command": "adoCode.workItemsFilter",
        "title": "Filter Work Items",
        "icon": "$(filter)"
      },
      {
        "command": "adoCode.workItemsSearch",
        "title": "Search Work Items",
        "icon": "$(search)"
      },
      {
        "command": "adoCode.workItemsClearFilters",
        "title": "Clear Filters",
        "icon": "$(clear-all)"
      },
      {
        "command": "adoCode.generateTasks",
        "title": "Generate Tasks",
        "icon": "$(list-tree)"
      }
    ],
    "keybindings": [
      {
        "command": "adoCode.chat.focus",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "adoCode.refreshWorkItems",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      },
      {
        "command": "adoCode.cycleMode",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "view == adoCode.status"
      },
      {
        "command": "adoCode.refreshStatus",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "view == adoCode.status"
      },
      {
        "command": "adoCode.memorySearch",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "view == adoCode.status"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "adoCode.generateCommitMessage",
          "when": "scmRepositoryHasChanges",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "adoCode.workItemsFilter",
          "when": "view == adoCode.workItems",
          "group": "navigation"
        },
        {
          "command": "adoCode.workItemsSearch",
          "when": "view == adoCode.workItems",
          "group": "navigation"
        },
        {
          "command": "adoCode.workItemsClearFilters",
          "when": "view == adoCode.workItems",
          "group": "navigation"
        },
        {
          "command": "adoCode.workItemsFilter",
          "when": "view == adoCode.unassignedWorkItems",
          "group": "navigation"
        },
        {
          "command": "adoCode.workItemsSearch",
          "when": "view == adoCode.unassignedWorkItems",
          "group": "navigation"
        },
        {
          "command": "adoCode.workItemsClearFilters",
          "when": "view == adoCode.unassignedWorkItems",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "adoCode.startTask",
          "when": "viewItem == workItemNode",
          "group": "inline"
        },
        {
          "command": "adoCode.reviewTaskDetail",
          "when": "viewItem == workItemNode",
          "group": "1_workItem@2"
        },
        {
          "command": "adoCode.showWorkItemDetail",
          "when": "viewItem == workItemNode",
          "group": "1_workItem@3"
        },
        {
          "command": "adoCode.startTaskWithAgent",
          "when": "viewItem == workItemNode",
          "group": "2_agent@1"
        },
        {
          "command": "adoCode.requestClarification",
          "when": "viewItem == workItemNode",
          "group": "3_communication@1"
        },
        {
          "command": "adoCode.checkTaskReplies",
          "when": "viewItem == workItemNode",
          "group": "3_communication@2"
        },
        {
          "command": "adoCode.changeWorkItemState",
          "when": "viewItem == workItemNode",
          "group": "4_state@1"
        },
        {
          "command": "adoCode.generateTasks",
          "when": "viewItem == workItemNode",
          "group": "6_generate@1"
        },
        {
          "command": "adoCode.showWorkItemDetail",
          "when": "viewItem == unassignedWorkItemNode",
          "group": "1_workItem@3"
        },
        {
          "command": "adoCode.selectWorkItem",
          "when": "viewItem == workItemNode || viewItem == unassignedWorkItemNode",
          "group": "4_state@2"
        },
        {
          "command": "adoCode.unselectWorkItem",
          "when": "(viewItem == workItemNode || viewItem == unassignedWorkItemNode) && adoCode.workItemSelected",
          "group": "4_state@3"
        },
        {
          "command": "adoCode.takeOwnership",
          "when": "viewItem == unassignedWorkItemNode",
          "group": "1_workItem@1"
        },
        {
          "command": "adoCode.reassignWorkItem",
          "when": "viewItem == workItemNode || viewItem == unassignedWorkItemNode",
          "group": "5_assignment@1"
        },
        {
          "command": "adoCode.deleteMemory",
          "when": "viewItem == statusMemoryUser || viewItem == statusMemoryWorkspace",
          "group": "1_memory@1"
        },
        {
          "command": "adoCode.moveToWorkspaceMemory",
          "when": "viewItem == statusMemoryUser",
          "group": "2_memory@1"
        },
        {
          "command": "adoCode.moveToUserMemory",
          "when": "viewItem == statusMemoryWorkspace",
          "group": "2_memory@1"
        },
        {
          "command": "adoCode.memoryExport",
          "when": "view == adoCode.status && viewItem == statusMemory",
          "group": "1_memory@2"
        },
        {
          "command": "adoCode.memoryImport",
          "when": "view == adoCode.status && viewItem == statusMemory",
          "group": "1_memory@3"
        },
        {
          "command": "adoCode.openAgentInTerminal",
          "when": "viewItem == statusAgent",
          "group": "1_agent@1"
        },
        {
          "command": "adoCode.copyAgentName",
          "when": "viewItem == statusAgent",
          "group": "2_agent@1"
        },
        {
          "command": "adoCode.agentViewDetail",
          "when": "viewItem == statusAgent",
          "group": "3_agent@1"
        },
        {
          "command": "adoCode.openWorktreeInTerminal",
          "when": "viewItem == statusWorktree || viewItem == worktreeNode",
          "group": "1_worktree@1"
        },
        {
          "command": "adoCode.openWorktreeInExplorer",
          "when": "viewItem == statusWorktree || viewItem == worktreeNode",
          "group": "1_worktree@2"
        },
        {
          "command": "adoCode.removeWorktree",
          "when": "viewItem == statusWorktree || viewItem == worktreeNode",
          "group": "2_worktree@2"
        },
        {
          "command": "adoCode.cleanupWorktree",
          "when": "viewItem == statusWorktree || viewItem == worktreeNode",
          "group": "3_worktree@2"
        },
        {
          "command": "adoCode.commitWorktree",
          "when": "viewItem == statusWorktree || viewItem == worktreeNode",
          "group": "2_worktree@1"
        },
        {
          "command": "adoCode.showAgentOutput",
          "when": "viewItem == statusWorktree || viewItem == worktreeNode",
          "group": "3_worktree@1"
        },
        {
          "command": "adoCode.worktreeShowChanges",
          "when": "viewItem == worktreeNode",
          "group": "1_worktree@3"
        },
        {
          "command": "adoCode.worktreeShowChanges",
          "when": "view == adoCode.status && viewItem == statusRun",
          "group": "1_run@4"
        },
        {
          "command": "adoCode.cycleMode",
          "when": "view == adoCode.status && viewItem == statusMode",
          "group": "inline"
        },
        {
          "command": "adoCode.memorySearch",
          "when": "view == adoCode.status && viewItem == statusMemory",
          "group": "1_memory@1"
        },
        {
          "command": "adoCode.setMode",
          "when": "view == adoCode.status && viewItem == statusMode",
          "group": "1_mode@1"
        },
        {
          "command": "adoCode.mcpDisconnect",
          "when": "viewItem == statusMcpServer",
          "group": "1_mcp@1"
        },
        {
          "command": "adoCode.mcpReconnect",
          "when": "viewItem == statusMcpServer",
          "group": "1_mcp@2"
        },
        {
          "command": "adoCode.mcpViewDetails",
          "when": "viewItem == statusMcpServer",
          "group": "1_mcp@3"
        },
        {
          "command": "adoCode.worktreesRemoveAllCompleted",
          "when": "viewItem == worktreesRoot",
          "group": "cleanup@1"
        },
        {
          "command": "adoCode.runViewSummary",
          "when": "view == adoCode.status && viewItem == statusRun",
          "group": "1_run@1"
        },
        {
          "command": "adoCode.runOpenWorktree",
          "when": "view == adoCode.status && viewItem == statusRun",
          "group": "1_run@2"
        },
        {
          "command": "adoCode.runCopyId",
          "when": "view == adoCode.status && viewItem == statusRun",
          "group": "1_run@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "adoCode",
          "title": "ADO Code",
          "icon": "$(comment-discussion)"
        }
      ],
      "secondaryBar": [
        {
          "id": "adoCodeSecondary",
          "title": "ADO Code (Secondary)",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "adoCode": [
        {
          "type": "webview",
          "id": "adoCode.chat",
          "name": "Chat"
        },
        {
          "id": "adoCode.workItems",
          "name": "My Work Items",
          "type": "tree"
        },
        {
          "id": "adoCode.unassignedWorkItems",
          "name": "Unassigned Work Items",
          "type": "tree"
        },
        {
          "id": "adoCode.status",
          "name": "Status",
          "type": "tree"
        },
        {
          "id": "adoCode.worktrees",
          "name": "Worktrees",
          "type": "tree"
        }
      ]
    },
    "configuration": {
      "title": "ADO Code",
      "properties": {
        "adoCode.organizations": {
          "type": "array",
          "default": [],
          "description": "ADO organizations the developer works with: [{ \"name\": \"mycompany\", \"url\": \"https://dev.azure.com/mycompany\", \"project\": \"MyProject\" }]. The ACTIVE org is picked per workspace (workspaceState), see adoCode.adoOrganization/adoCode.adoProject (Q1 resolution)."
        },
        "adoCode.adoOrganization": {
          "type": "string",
          "default": "",
          "description": "Active Azure DevOps organization name for this workspace (e.g., 'mycompany')"
        },
        "adoCode.adoProject": {
          "type": "string",
          "default": "",
          "description": "Active Azure DevOps project name for this workspace"
        },
        "adoCode.adoServerUrl": {
          "type": "string",
          "default": "",
          "description": "Optional ADO Server (on-premises) base URL, e.g. 'https://ado.corp.local/tfs/DefaultCollection'. Empty = cloud ADO Services (https://dev.azure.com/{org}). Used verbatim when set (Q2 resolution)."
        },
        "adoCode.adoPat": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps Personal Access Token",
          "format": "password"
        },
        "adoCode.llmProvider": {
          "type": "string",
          "default": "openai",
          "enum": [
            "openai",
            "anthropic"
          ],
          "enumDescriptions": [
            "OpenAI-compatible API (OpenAI, Ollama, LM Studio, vLLM, OpenRouter, etc. — not Azure OpenAI; see M13)",
            "Anthropic Messages API (Claude, Amazon Bedrock, self-hosted Anthropic-compatible)"
          ],
          "description": "LLM provider type — determines API format and authentication"
        },
        "adoCode.llmApiUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "LLM API base URL. For Anthropic: use https://api.anthropic.com. For self-hosted: use your local endpoint."
        },
        "adoCode.llmApiKey": {
          "type": "string",
          "default": "",
          "description": "LLM API key",
          "format": "password"
        },
        "adoCode.llmModel": {
          "type": "string",
          "default": "gpt-4o",
          "description": "LLM model name (e.g., gpt-4o, claude-sonnet-4-20250514, llama3, etc.)"
        },
        "adoCode.llm.choiceDetectionModel": {
          "type": "string",
          "default": "",
          "description": "Optional CHEAPER model used to detect choice prompts in AI responses (e.g. 'gpt-4o-mini'). Empty = use the main llmModel. Set to 'off' to disable LLM-assisted detection (regex-only)."
        },
        "adoCode.llm.capabilityOverrides": {
          "type": "array",
          "default": [],
          "description": "Per-model capability overrides: [{ \"model\": \"deepseek-v4\", \"vision\": true }] — user-declared values beat both gateway capability hints and name heuristics. Leave a field unset to keep the auto-detected value."
        },
        "adoCode.llm.modeConfigs": {
          "type": "object",
          "default": {},
          "description": "Per-mode model overrides in Advanced mode: { \"inline\": { \"model\": \"gpt-4o\" }, \"plan\": { \"model\": \"gpt-4o\" }, \"act\": { \"model\": \"o3\" } }. Each mode can use a different model. Empty object = use the global llmModel."
        },
        "adoCode.llm.modeReasoningEffort": {
          "type": "object",
          "default": {},
          "description": "Per-mode reasoning effort for reasoning models (o1, o3, o4-mini, etc.): { \"inline\": \"low\", \"plan\": \"medium\", \"act\": \"high\" }. Values: 'low', 'medium', 'high'. Empty object = no reasoning effort override."
        },
        "adoCode.advancedConfig": {
          "type": "boolean",
          "default": false,
          "description": "Enable Advanced Configuration mode — allows per-mode model selection and reasoning effort tuning."
        },
        "adoCode.git.requireGitRepo": {
          "type": "boolean",
          "default": true,
          "description": "Block task pickup when the workspace is not inside a git repository"
        },
        "adoCode.git.createBranchOnTaskStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically create a feature/ADO-<id>-<slug> branch when picking up a work item"
        },
        "adoCode.git.requireCleanTree": {
          "type": "boolean",
          "default": false,
          "description": "Warn and require confirmation when switching branches with uncommitted changes"
        },
        "adoCode.git.prOnCompletion": {
          "type": "boolean",
          "default": false,
          "description": "On task completion, offer to push the branch and create a PR via gh CLI (Q5 resolution — opt-in)"
        },
        "adoCode.git.protectedBranches": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["main", "master"],
          "description": "Branches create_pull_request must never target — the AI merge flow refuses to open a PR against these"
        },
        "adoCode.mode": {
          "type": "string",
          "default": "inline",
          "enum": [
            "inline",
            "plan",
            "act"
          ],
          "enumDescriptions": [
            "Streaming answer; tool calls shown inline, mutating tools require approval",
            "Read-only tools only; produces a plan; 'Begin implementation' switches to act",
            "Autonomous agentic loop with auto-approval of mutating tools (tool budget + terminal allowlist)"
          ],
          "description": "LLM tool-use mode (Q8 resolution)"
        },
        "adoCode.act.toolBudget": {
          "type": "number",
          "default": 50,
          "description": "Max tool calls per act-mode turn"
        },
        "adoCode.act.terminalAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "npm test",
            "npm run lint",
            "git diff",
            "git status"
          ],
          "description": "Allowed command prefixes for run_terminal_command in act mode"
        },
        "adoCode.changelog.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Create/update CHANGELOG.md when a work item is completed (state Done/Closed)"
        },
        "adoCode.changelog.autoCommit": {
          "type": "boolean",
          "default": true,
          "description": "Commit the CHANGELOG.md update automatically on task completion"
        },
        "adoCode.changelog.postToAdo": {
          "type": "boolean",
          "default": true,
          "description": "Post the changelog entry as a comment on the Azure DevOps work item when it is completed"
        },
        "adoCode.ado.clarificationState": {
          "type": "string",
          "default": "Blocked",
          "description": "State to set on a work item when clarification is requested. Empty string = do not change state. (Must be a valid state for your process template.)"
        },
        "adoCode.ado.warnOnSparseTask": {
          "type": "boolean",
          "default": true,
          "description": "Before starting a task with no description AND no acceptance criteria, warn and offer to review detail or request clarification"
        },
        "adoCode.ignore.dotAdoCode": {
          "type": "boolean",
          "default": true,
          "description": "Ensure `.ado-code` (workspace memory, checkpoints, agent runs) is listed in `.gitignore` and `.dockerignore`; offers to add it when missing. Declining the offer is remembered per workspace (re-enable later by removing the entry from the ignore files and reloading)."
        },
        "adoCode.sessions.maxPerProject": {
          "type": "number",
          "default": 20,
          "description": "Maximum number of chat sessions to keep per workspace + ADO project. Older sessions beyond this limit are auto-pruned."
        },
        "adoCode.agents.enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "codex",
              "opencode",
              "hermes",
              "pi",
              "openclaw",
              "aider",
              "gemini",
              "cursor-agent"
            ]
          },
          "default": [
            "claude",
            "codex",
            "opencode",
            "hermes",
            "pi",
            "openclaw",
            "aider",
            "gemini",
            "cursor-agent"
          ],
          "description": "Which external agents ADO Code may delegate to (Q9: aider, gemini, cursor-agent added). M17: default includes all registered agents; users can prune."
        },
        "adoCode.agents.verifyCommand": {
          "type": "string",
          "default": "",
          "description": "Shell command run after an agent finishes to verify work (e.g. 'npm test'). Empty = skip."
        },
        "adoCode.agents.autoSelect": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "claude",
            "codex",
            "opencode",
            "hermes",
            "pi",
            "openclaw",
            "aider",
            "gemini",
            "cursor-agent"
          ],
          "description": "Default agent for delegation when none is specified (M-9: includes all 9 registered agents)"
        },
        "adoCode.agents.autoReview": {
          "type": "boolean",
          "default": true,
          "description": "Automatically review agent changes via LLM when a run completes"
        },
        "adoCode.mcp.servers": {
          "type": "array",
          "default": [],
          "description": "MCP servers to connect to: [{ \"name\": \"myserver\", \"command\": \"npx\", \"args\": [\"-y\", \"@myorg/mcp-server\"] }]"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "build:webview": "cd src/webview-ui && npm install && npm run build",
    "build:all": "npm run compile && npm run build:webview",
    "watch:webview": "cd src/webview-ui && npm run watch",
    "test": "node ./out/test/runTest.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "node scripts/pre-commit.js"
    ]
  },
