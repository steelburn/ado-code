{
  "name": "ado-code",
  "displayName": "ADO Code",
  "description": "AI coding assistant with Azure DevOps integration",
  "version": "0.6.5",
  "publisher": "steelburn",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:adoCode.chat",
    "onView:adoCode.workItems",
    "onCommand:adoCode.chat.focus",
    "onCommand:adoCode.refreshWorkItems",
    "onCommand:adoCode.startTask",
    "onCommand:adoCode.selectWorkItem",
    "onCommand:adoCode.delegateToAgent",
    "onCommand:adoCode.startTaskWithAgent",
    "onCommand:adoCode.reviewTaskDetail",
    "onCommand:adoCode.requestClarification",
    "onCommand:adoCode.checkTaskReplies",
    "onCommand:adoCode.openAgentProgress",
    "onCommand:adoCode.changeWorkItemState",
    "onCommand:adoCode.takeOwnership",
    "onCommand:adoCode.reassignWorkItem",
    "onCommand:adoCode.generateCommitMessage",
    "onView:adoCode.status",
    "onView:adoCode.worktrees",
    "onCommand:adoCode.refreshStatus",
    "onCommand:adoCode.showMemory",
    "onCommand:adoCode.editMemory",
    "onCommand:adoCode.clearMemory",
    "onCommand:adoCode.showWorkspaceMemory",
    "onCommand:adoCode.memoryExport",
    "onCommand:adoCode.memoryImport",
    "onCommand:adoCode.setMode",
    "onCommand:adoCode.listCheckpoints",
    "onCommand:adoCode.showTokenUsage",
    "onCommand:adoCode.mcpDisconnect",
    "onCommand:adoCode.mcpReconnect",
    "onCommand:adoCode.mcpViewDetails",
    "onCommand:adoCode.agentViewDetail",
    "onCommand:adoCode.memorySearch",
    "onCommand:adoCode.workItemsFilter",
    "onCommand:adoCode.workItemsSearch",
    "onCommand:adoCode.workItemsClearFilters",
    "onCommand:adoCode.worktreeShowChanges",
    "onCommand:adoCode.generateTasks",
    "onCommand:adoCode.sendSelectionToChat",
    "onCommand:adoCode.sendFileToChat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "adoCode.selectWorkItem",
        "title": "Select Work Item",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.startTask",
        "title": "Start Task",
        "icon": "$(rocket)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.switchOrganization",
        "title": "Switch Organization…",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.refreshWorkItems",
        "title": "Refresh Work Items",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.chat.focus",
        "title": "Focus Chat",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.delegateToAgent",
        "title": "Delegate to Agent…",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.startTaskWithAgent",
        "title": "Assign to Agent…",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.reviewTaskDetail",
        "title": "Review Task Detail",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.showWorkItemDetail",
        "title": "Show Full Details",
        "icon": "$(open-preview)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.requestClarification",
        "title": "Request Clarification…",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.checkTaskReplies",
        "title": "Check Work Item Replies",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.changeWorkItemState",
        "title": "Change Work Item State",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.takeOwnership",
        "title": "Take Ownership of Work Item",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.reassignWorkItem",
        "title": "Reassign Work Item…",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.unselectWorkItem",
        "title": "Deselect Work Item",
        "icon": "$(close-all)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.deleteMemory",
        "title": "Delete Memory",
        "icon": "$(trash)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.moveToWorkspaceMemory",
        "title": "Move to Workspace Memory",
        "icon": "$(folder-opened)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.moveToUserMemory",
        "title": "Move to User Memory",
        "icon": "$(person)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.openAgentInTerminal",
        "title": "Open in Terminal",
        "icon": "$(terminal)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.openAgentProgress",
        "title": "Open Agent Progress…",
        "icon": "$(debug-continue)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.copyAgentName",
        "title": "Copy Agent Name",
        "icon": "$(clippy)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.openWorktreeInTerminal",
        "title": "Open Worktree in Terminal",
        "icon": "$(terminal)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.openWorktreeInExplorer",
        "title": "Open Worktree in Explorer",
        "icon": "$(folder-opened)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.removeWorktree",
        "title": "Remove Worktree",
        "icon": "$(trash)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.commitWorktree",
        "title": "Commit & Push Worktree",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.cleanupWorktree",
        "title": "Clean Up After Merge",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.worktreeShowChanges",
        "title": "Show Changes",
        "icon": "$(diff)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.generateCommitMessage",
        "title": "Generate Commit Message",
        "icon": "$(sparkle)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.refreshStatus",
        "title": "Refresh Status",
        "icon": "$(refresh)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.refreshUnderstanding",
        "title": "Refresh Repository Understanding",
        "icon": "$(lightbulb)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.refreshWorktrees",
        "title": "Refresh Worktrees",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.worktreesRemoveAllCompleted",
        "title": "Remove All Completed Worktrees",
        "icon": "$(trash)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.showAgentOutput",
        "title": "Show Agent Output",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.showMemory",
        "title": "Show Memory",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.editMemory",
        "title": "Edit Memory Entry…",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.clearMemory",
        "title": "Clear All Memory",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.showWorkspaceMemory",
        "title": "Show Workspace Memory",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.memoryExport",
        "title": "Export Memories",
        "icon": "$(export)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.memoryImport",
        "title": "Import Memories",
        "icon": "$(import)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.memorySearch",
        "title": "Search Memories",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.setMode",
        "title": "Set Mode…",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.listCheckpoints",
        "title": "List Checkpoints…",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.showTokenUsage",
        "title": "Show Token Usage",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.cycleMode",
        "title": "Cycle Mode",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.mcpDisconnect",
        "title": "Disconnect MCP Server",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.mcpReconnect",
        "title": "Reconnect MCP Server",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.mcpViewDetails",
        "title": "MCP Server Details",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.runViewSummary",
        "title": "View Agent Summary",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.runOpenWorktree",
        "title": "Open Agent Worktree",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.runCopyId",
        "title": "Copy Agent Run ID",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.agentViewDetail",
        "title": "View Agent Run Details",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.workItemsFilter",
        "title": "Filter Work Items",
        "icon": "$(filter)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.workItemsSearch",
        "title": "Search Work Items",
        "icon": "$(search)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.workItemsClearFilters",
        "title": "Clear Filters",
        "icon": "$(clear-all)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.workItemsToggleMode",
        "title": "Switch Work Items View (My / All / Unassigned)",
        "icon": "$(list-selection)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.generateTasks",
        "title": "Generate Tasks",
        "icon": "$(list-tree)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.sendSelectionToChat",
        "title": "ADO Code: Send Selection to Chat",
        "icon": "$(comment-discussion)",
        "category": "ADO Code"
      },
      {
        "command": "adoCode.sendFileToChat",
        "title": "ADO Code: Send File to Chat",
        "icon": "$(comment-discussion)",
        "category": "ADO Code"
      }
    ],
    "keybindings": [
      {
        "command": "adoCode.chat.focus",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "adoCode.refreshWorkItems",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      },
      {
        "command": "adoCode.cycleMode",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "view == adoCode.status"
      },
      {
        "command": "adoCode.refreshStatus",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "view == adoCode.status"
      },
      {
        "command": "adoCode.memorySearch",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "view == adoCode.status"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "adoCode.generateCommitMessage",
          "when": "scmRepositoryHasChanges",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "adoCode.workItemsToggleMode",
          "when": "view == adoCode.workItems",
          "group": "navigation"
        },
        {
          "command": "adoCode.workItemsFilter",
          "when": "view == adoCode.workItems",
          "group": "navigation"
        },
        {
          "command": "adoCode.workItemsSearch",
          "when": "view == adoCode.workItems",
          "group": "navigation"
        },
        {
          "command": "adoCode.workItemsClearFilters",
          "when": "view == adoCode.workItems",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "adoCode.startTask",
          "when": "viewItem == workItemNode",
          "group": "inline"
        },
        {
          "command": "adoCode.reviewTaskDetail",
          "when": "viewItem == workItemNode",
          "group": "1_workItem@2"
        },
        {
          "command": "adoCode.showWorkItemDetail",
          "when": "viewItem == workItemNode",
          "group": "1_workItem@3"
        },
        {
          "command": "adoCode.startTaskWithAgent",
          "when": "viewItem == workItemNode",
          "group": "2_agent@1"
        },
        {
          "command": "adoCode.requestClarification",
          "when": "viewItem == workItemNode",
          "group": "3_communication@1"
        },
        {
          "command": "adoCode.checkTaskReplies",
          "when": "viewItem == workItemNode",
          "group": "3_communication@2"
        },
        {
          "command": "adoCode.changeWorkItemState",
          "when": "viewItem == workItemNode",
          "group": "4_state@1"
        },
        {
          "command": "adoCode.generateTasks",
          "when": "viewItem == workItemNode",
          "group": "6_generate@1"
        },
        {
          "command": "adoCode.showWorkItemDetail",
          "when": "viewItem == unassignedWorkItemNode",
          "group": "1_workItem@3"
        },
        {
          "command": "adoCode.selectWorkItem",
          "when": "viewItem == workItemNode || viewItem == unassignedWorkItemNode",
          "group": "4_state@2"
        },
        {
          "command": "adoCode.unselectWorkItem",
          "when": "(viewItem == workItemNode || viewItem == unassignedWorkItemNode) && adoCode.workItemSelected",
          "group": "4_state@3"
        },
        {
          "command": "adoCode.takeOwnership",
          "when": "viewItem == unassignedWorkItemNode",
          "group": "1_workItem@1"
        },
        {
          "command": "adoCode.reassignWorkItem",
          "when": "viewItem == workItemNode || viewItem == unassignedWorkItemNode",
          "group": "5_assignment@1"
        },
        {
          "command": "adoCode.deleteMemory",
          "when": "viewItem == statusMemoryUser || viewItem == statusMemoryWorkspace",
          "group": "1_memory@1"
        },
        {
          "command": "adoCode.moveToWorkspaceMemory",
          "when": "viewItem == statusMemoryUser",
          "group": "2_memory@1"
        },
        {
          "command": "adoCode.moveToUserMemory",
          "when": "viewItem == statusMemoryWorkspace",
          "group": "2_memory@1"
        },
        {
          "command": "adoCode.memoryExport",
          "when": "view == adoCode.status && viewItem == statusMemory",
          "group": "1_memory@2"
        },
        {
          "command": "adoCode.memoryImport",
          "when": "view == adoCode.status && viewItem == statusMemory",
          "group": "1_memory@3"
        },
        {
          "command": "adoCode.openAgentInTerminal",
          "when": "viewItem == statusAgent",
          "group": "1_agent@1"
        },
        {
          "command": "adoCode.copyAgentName",
          "when": "viewItem == statusAgent",
          "group": "2_agent@1"
        },
        {
          "command": "adoCode.agentViewDetail",
          "when": "viewItem == statusAgent",
          "group": "3_agent@1"
        },
        {
          "command": "adoCode.openWorktreeInTerminal",
          "when": "viewItem == statusWorktree || viewItem == worktreeNode",
          "group": "1_worktree@1"
        },
        {
          "command": "adoCode.openWorktreeInExplorer",
          "when": "viewItem == statusWorktree || viewItem == worktreeNode",
          "group": "1_worktree@2"
        },
        {
          "command": "adoCode.removeWorktree",
          "when": "viewItem == statusWorktree || viewItem == worktreeNode",
          "group": "2_worktree@2"
        },
        {
          "command": "adoCode.cleanupWorktree",
          "when": "viewItem == statusWorktree || viewItem == worktreeNode",
          "group": "3_worktree@2"
        },
        {
          "command": "adoCode.commitWorktree",
          "when": "viewItem == statusWorktree || viewItem == worktreeNode",
          "group": "2_worktree@1"
        },
        {
          "command": "adoCode.showAgentOutput",
          "when": "viewItem == statusWorktree || viewItem == worktreeNode",
          "group": "3_worktree@1"
        },
        {
          "command": "adoCode.worktreeShowChanges",
          "when": "viewItem == worktreeNode",
          "group": "1_worktree@3"
        },
        {
          "command": "adoCode.worktreeShowChanges",
          "when": "view == adoCode.status && viewItem == statusRun",
          "group": "1_run@4"
        },
        {
          "command": "adoCode.cycleMode",
          "when": "view == adoCode.status && viewItem == statusMode",
          "group": "inline"
        },
        {
          "command": "adoCode.memorySearch",
          "when": "view == adoCode.status && viewItem == statusMemory",
          "group": "1_memory@1"
        },
        {
          "command": "adoCode.setMode",
          "when": "view == adoCode.status && viewItem == statusMode",
          "group": "1_mode@1"
        },
        {
          "command": "adoCode.mcpDisconnect",
          "when": "viewItem == statusMcpServer",
          "group": "1_mcp@1"
        },
        {
          "command": "adoCode.mcpReconnect",
          "when": "viewItem == statusMcpServer",
          "group": "1_mcp@2"
        },
        {
          "command": "adoCode.mcpViewDetails",
          "when": "viewItem == statusMcpServer",
          "group": "1_mcp@3"
        },
        {
          "command": "adoCode.worktreesRemoveAllCompleted",
          "when": "viewItem == worktreesRoot",
          "group": "cleanup@1"
        },
        {
          "command": "adoCode.runViewSummary",
          "when": "view == adoCode.status && viewItem == statusRun",
          "group": "1_run@1"
        },
        {
          "command": "adoCode.runOpenWorktree",
          "when": "view == adoCode.status && viewItem == statusRun",
          "group": "1_run@2"
        },
        {
          "command": "adoCode.runCopyId",
          "when": "view == adoCode.status && viewItem == statusRun",
          "group": "1_run@3"
        }
      ],
      "editor/context": [
        {
          "command": "adoCode.sendSelectionToChat",
          "when": "editorHasSelection",
          "group": "1_adoCode@1"
        }
      ],
      "explorer/context": [
        {
          "command": "adoCode.sendFileToChat",
          "when": "!explorerResourceIsFolder",
          "group": "1_adoCode@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "adoCode",
          "title": "ADO Code",
          "icon": "$(comment-discussion)"
        }
      ],
      "secondaryBar": [
        {
          "id": "adoCodeSecondary",
          "title": "ADO Code (Secondary)",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "adoCode": [
        {
          "type": "webview",
          "id": "adoCode.chat",
          "name": "Chat"
        },
        {
          "id": "adoCode.workItems",
          "name": "Work Items",
          "type": "tree"
        },
        {
          "id": "adoCode.status",
          "name": "Status",
          "type": "tree"
        },
        {
          "id": "adoCode.worktrees",
          "name": "Worktrees",
          "type": "tree"
        }
      ]
    },
    "configuration": {
      "title": "ADO Code",
      "properties": {
        "adoCode.organizations": {
          "type": "array",
          "default": [],
          "description": "ADO organizations the developer works with: [{ \"name\": \"mycompany\", \"url\": \"https://dev.azure.com/mycompany\", \"project\": \"MyProject\" }]. The ACTIVE org is picked per workspace (workspaceState), see adoCode.adoOrganization/adoCode.adoProject (Q1 resolution)."
        },
        "adoCode.adoOrganization": {
          "type": "string",
          "default": "",
          "description": "Active Azure DevOps organization name for this workspace (e.g., 'mycompany')"
        },
        "adoCode.adoProject": {
          "type": "string",
          "default": "",
          "description": "Active Azure DevOps project name for this workspace"
        },
        "adoCode.adoServerUrl": {
          "type": "string",
          "default": "",
          "description": "Optional ADO Server (on-premises) base URL, e.g. 'https://ado.corp.local/tfs/DefaultCollection'. Empty = cloud ADO Services (https://dev.azure.com/{org}). Used verbatim when set (Q2 resolution)."
        },
        "adoCode.adoPat": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps Personal Access Token",
          "format": "password"
        },
        "adoCode.llmProvider": {
          "type": "string",
          "default": "openai",
          "enum": [
            "openai",
            "anthropic"
          ],
          "enumDescriptions": [
            "OpenAI-compatible API (OpenAI, Ollama, LM Studio, vLLM, OpenRouter, etc. — not Azure OpenAI; see M13)",
            "Anthropic Messages API (Claude, Amazon Bedrock, self-hosted Anthropic-compatible)"
          ],
          "description": "LLM provider type — determines API format and authentication"
        },
        "adoCode.llmApiUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "LLM API base URL. For Anthropic: use https://api.anthropic.com. For self-hosted: use your local endpoint."
        },
        "adoCode.llmApiKey": {
          "type": "string",
          "default": "",
          "description": "LLM API key",
          "format": "password"
        },
        "adoCode.llmModel": {
          "type": "string",
          "default": "gpt-4o",
          "description": "LLM model name (e.g., gpt-4o, claude-sonnet-4-20250514, llama3, etc.)"
        },
        "adoCode.llm.choiceDetectionModel": {
          "type": "string",
          "default": "",
          "description": "Optional CHEAPER model used to detect choice prompts in AI responses (e.g. 'gpt-4o-mini'). Empty = use the main llmModel. Set to 'off' to disable LLM-assisted detection (regex-only)."
        },
        "adoCode.llm.capabilityOverrides": {
          "type": "array",
          "default": [],
          "description": "Per-model capability overrides: [{ \"model\": \"deepseek-v4\", \"vision\": true }] — user-declared values beat both gateway capability hints and name heuristics. Leave a field unset to keep the auto-detected value."
        },
        "adoCode.llm.modeConfigs": {
          "type": "object",
          "default": {},
          "description": "Per-mode model overrides in Advanced mode: { \"inline\": { \"model\": \"gpt-4o\" }, \"plan\": { \"model\": \"gpt-4o\" }, \"act\": { \"model\": \"o3\" } }. Each mode can use a different model. Empty object = use the global llmModel."
        },
        "adoCode.llm.modeReasoningEffort": {
          "type": "object",
          "default": {},
          "description": "Per-mode reasoning effort for reasoning models (o1, o3, o4-mini, etc.): { \"inline\": \"low\", \"plan\": \"medium\", \"act\": \"high\" }. Values: 'low', 'medium', 'high'. Empty object = no reasoning effort override."
        },
        "adoCode.advancedConfig": {
          "type": "boolean",
          "default": false,
          "description": "Enable Advanced Configuration mode — allows per-mode model selection and reasoning effort tuning."
        },
        "adoCode.git.requireGitRepo": {
          "type": "boolean",
          "default": true,
          "description": "Block task pickup when the workspace is not inside a git repository"
        },
        "adoCode.git.createBranchOnTaskStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically create a feature/ADO-<id>-<slug> branch when picking up a work item"
        },
        "adoCode.git.requireCleanTree": {
          "type": "boolean",
          "default": false,
          "description": "Warn and require confirmation when switching branches with uncommitted changes"
        },
        "adoCode.git.prOnCompletion": {
          "type": "boolean",
          "default": false,
          "description": "On task completion, offer to push the branch and create a PR via gh CLI (Q5 resolution — opt-in)"
        },
        "adoCode.git.protectedBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "main",
            "master"
          ],
          "description": "Branches create_pull_request must never target — the AI merge flow refuses to open a PR against these"
        },
        "adoCode.mode": {
          "type": "string",
          "default": "inline",
          "enum": [
            "inline",
            "plan",
            "act",
            "yolo"
          ],
          "enumDescriptions": [
            "Streaming answer; tool calls shown inline, mutating tools require approval",
            "Read-only tools only; produces a plan; 'Begin implementation' switches to act",
            "Autonomous agentic loop with auto-approval of mutating tools (iteration budget + terminal allowlist)",
            "Full autonomy — auto-approves everything except pushing to the remote repo (see adoCode.yolo.pushApproval)"
          ],
          "description": "LLM tool-use mode (Q8 resolution)"
        },
        "adoCode.act.toolBudget": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Max agentic loop iterations per chat turn (each iteration = one model round-trip that may run a batch of tool calls in parallel; applies to all modes). Recommended: 100+ — this extension works on large repositories where deep, multi-step work is common."
        },
        "adoCode.act.terminalAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "npm test",
            "npm run lint",
            "git diff",
            "git status"
          ],
          "description": "Allowed commands for run_terminal_command in act mode. Exact commands (\"npm test\") or wildcard patterns (\"git *\", \"npm run *\") — a trailing * matches any remaining tokens."
        },
        "adoCode.changelog.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Create/update CHANGELOG.md when a work item is completed (state Done/Closed)"
        },
        "adoCode.changelog.autoCommit": {
          "type": "boolean",
          "default": true,
          "description": "Commit the CHANGELOG.md update automatically on task completion"
        },
        "adoCode.changelog.postToAdo": {
          "type": "boolean",
          "default": true,
          "description": "Post the changelog entry as a comment on the Azure DevOps work item when it is completed"
        },
        "adoCode.ado.clarificationState": {
          "type": "string",
          "default": "Blocked",
          "description": "State to set on a work item when clarification is requested. Empty string = do not change state. (Must be a valid state for your process template.)"
        },
        "adoCode.ado.warnOnSparseTask": {
          "type": "boolean",
          "default": true,
          "description": "Before starting a task with no description AND no acceptance criteria, warn and offer to review detail or request clarification"
        },
        "adoCode.ignore.dotAdoCode": {
          "type": "boolean",
          "default": true,
          "description": "Ensure `.ado-code` (workspace memory, checkpoints, agent runs) is listed in `.gitignore` and `.dockerignore`; offers to add it when missing. Declining the offer is remembered per workspace (re-enable later by removing the entry from the ignore files and reloading)."
        },
        "adoCode.sessions.maxPerProject": {
          "type": "number",
          "default": 20,
          "description": "Maximum number of chat sessions to keep per workspace + ADO project. Older sessions beyond this limit are auto-pruned."
        },
        "adoCode.agents.enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "codex",
              "opencode",
              "hermes",
              "pi",
              "openclaw",
              "aider",
              "gemini",
              "cursor-agent",
              "dsh"
            ]
          },
          "default": [
            "claude",
            "codex",
            "opencode",
            "hermes",
            "pi",
            "openclaw",
            "aider",
            "gemini",
            "cursor-agent",
            "dsh"
          ],
          "description": "Which external agents ADO Code may delegate to (Q9: aider, gemini, cursor-agent added; dsh: DeepSeek Harness). M17: default includes all registered agents; users can prune."
        },
        "adoCode.agents.verifyCommand": {
          "type": "string",
          "default": "",
          "description": "Shell command run after an agent finishes to verify work (e.g. 'npm test'). Empty = skip."
        },
        "adoCode.agents.autoSelect": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "claude",
            "codex",
            "opencode",
            "hermes",
            "pi",
            "openclaw",
            "aider",
            "gemini",
            "cursor-agent",
            "dsh"
          ],
          "description": "Default agent for delegation when none is specified (M-9: includes all registered agents)"
        },
        "adoCode.agents.autoReview": {
          "type": "boolean",
          "default": true,
          "description": "Automatically review agent changes via LLM when a run completes"
        },
        "adoCode.agents.autoCompleteChildren": {
          "type": "boolean",
          "default": false,
          "description": "After a delegated agent run on a parent work item finishes successfully, auto-complete its child items in ADO: children the agent's Delivery Report marks DONE transition to their terminal state (Task/Bug → Closed, Story/Feature/Epic → Resolved) and, when ALL open children are done, the parent closes too. Requires the agent's Delivery Report. Disabled = the run only reports and comments."
        },
        "adoCode.agents.progressView": {
          "type": "string",
          "default": "chat",
          "enum": [
            "chat",
            "editor"
          ],
          "enumDescriptions": [
            "Stream agent progress in the chat panel; open a static summary panel in the editor area when the run completes",
            "Auto-open a LIVE progress panel in the editor area as soon as a run starts — real-time output, elapsed time, and a progress bar; the same panel shows the final summary on completion"
          ],
          "description": "Where agent delegation progress is displayed. 'editor' opens a live, nicely formatted progress panel in the editor window; you can also move any run there on demand via the ↗ button in the chat panel or the 'Open Agent Progress' command."
        },
        "adoCode.mcp.servers": {
          "type": "array",
          "default": [],
          "description": "MCP servers to connect to: [{ \"name\": \"myserver\", \"command\": \"npx\", \"args\": [\"-y\", \"@myorg/mcp-server\"] }]"
        },
        "adoCode.understanding.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Cache repository + work-item understanding in .ado-code/understanding/ and inject it into chat sessions and delegated-agent prompts. Disabling stops regeneration; cached content stays on disk."
        },
        "adoCode.understanding.autoSummarize": {
          "type": "boolean",
          "default": true,
          "description": "Automatically generate an LLM repository summary when the repo fingerprint changes (new branch/commit, edited AGENTS.md/package.json/README). Uses one model call per change; refresh manually anytime via 'ADO Code: Refresh Repository Understanding'."
        },
        "adoCode.understanding.agentsMdSync": {
          "type": "boolean",
          "default": true,
          "description": "Keep AGENTS.md in sync with the repository understanding: generate one when missing, and offer an in-place update when the understanding (.ado-code/understanding) shows AGENTS.md is outdated (build/test/lint commands, project structure, or the LLM repo summary changed). Updates are user-approved and preserve your edits outside the managed block."
        },
        "adoCode.consent.harmlessAutoApprove": {
          "type": "boolean",
          "default": false,
          "description": "Auto-approve harmless (read-only) terminal commands — git status/diff/log, npm test, ls, grep, etc. — IMMEDIATELY, with no consent card and no countdown timer. Disabled = harmless commands still ask for approval like any other mutating tool."
        },
        "adoCode.yolo.pushApproval": {
          "type": "boolean",
          "default": true,
          "description": "Require approval before code is PUSHED to the remote repository (the push_worktree tool or a terminal \"git push\"), even in YOLO mode. Pushes are hard to undo and reach other people, so they stay gated by default. Set to false for full autonomy."
        },
        "adoCode.consent.autoApproveTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Tool names or glob patterns that run WITHOUT a consent prompt (e.g. \"read_*\", \"get_*\", \"edit_file\"). Matching tools skip the consent card in inline and act modes; plan mode stays read-only."
        },
        "adoCode.chat.showThinking": {
          "type": "boolean",
          "default": true,
          "description": "Display the model's thinking/reasoning text while it processes (o1/o3 reasoning, Claude extended thinking)."
        },
        "adoCode.chat.showToolCalls": {
          "type": "boolean",
          "default": true,
          "description": "Display tool calls as live cards (running → completed, with arguments and results) in the chat while the AI works. When off, tools run normally but chat shows only a subtle '…' indicator — no tool names, arguments, or results."
        },
        "adoCode.llm.useNativeTokenCounting": {
          "type": "boolean",
          "default": false,
          "description": "Use the provider's own tokenizer for the token status bar (Anthropic /v1/messages/count_tokens; OpenAI-compatible endpoints via usage.prompt_tokens from a minimal request). Anthropic counting is always on (free). For OpenAI-compatible gateways this issues a tiny model request per count, so it is opt-in here — off = always use the instant local estimate."
        },
        "adoCode.skillRegistryUrls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional skill registry URLs to fetch skills from (TSV format: slug<TAB>url<TAB>description). The built-in UI Skills registry is always included."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "build:webview": "cd src/webview-ui && npm install && npm run build",
    "build:all": "npm run compile && npm run build:webview",
    "watch:webview": "cd src/webview-ui && npm run watch",
    "test": "node ./out/test/runTest.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "node scripts/pre-commit.js"
    ]
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^8.56.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mocha": "^11.7.6",
    "typescript": "^5.3.3",
    "zod": "^3.23.0"
  },
  "overrides": {
    "mocha": {
      "diff": "^9.0.0",
      "serialize-javascript": "^7.0.7"
    }
  }
}
